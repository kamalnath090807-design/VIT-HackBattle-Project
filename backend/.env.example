# AURA Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env files containing real secrets to Git.

# Server Configuration
PORT=3001
NODE_ENV=development

# Database & Authentication (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# AI Provider Configuration — passed to agent module, NOT used directly in backend routes
AI_PROVIDER=groq
AI_ENABLE_FALLBACK=true

# Primary AI Provider: Groq Cloud API — used by agent module only
GROQ_API_KEY=
GROQ_MODEL=

# Secondary / Fallback AI Provider: Google Gemini API — used by agent module only
GEMINI_API_KEY=
GEMINI_MODEL=

# External Tool APIs — used by agent module's tool router only
OPENWEATHER_API_KEY=
GITHUB_TOKEN=

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173

# Rate Limiting
MAX_TASKS_PER_MINUTE=5
