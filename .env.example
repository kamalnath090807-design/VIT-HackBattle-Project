# AURA — Environment Variables Template
# Copy this file to .env and fill in your local/cloud credentials.
# NEVER commit .env files containing real secrets to Git.

# Server Configuration
PORT=3001
NODE_ENV=development

# Database & Authentication (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# AI Provider Configuration (groq | gemini, default: groq)
AI_PROVIDER=groq
AI_ENABLE_FALLBACK=true

# Primary AI Provider: Groq Cloud API
GROQ_API_KEY=
GROQ_MODEL=

# Secondary / Fallback AI Provider: Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=

# External Tool APIs (Optional / As needed for demonstration)
OPENWEATHER_API_KEY=
GITHUB_TOKEN=

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173

# Rate Limiting
MAX_TASKS_PER_MINUTE=5
