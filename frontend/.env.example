# AURA Frontend — Environment Configuration Template
# Copy this file to .env and configure for your environment.
# NEVER commit .env files containing real secrets to Git.

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Supabase Public/Anon Configuration (Client-safe)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Mock Mode (Set to true to run offline without live backend)
VITE_USE_MOCKS=false
